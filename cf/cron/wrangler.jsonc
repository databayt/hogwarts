{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hogwarts-cron",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 * * * *",
      "*/30 * * * *",
      "0 3 * * *",
      "0 2 * * *",
      "0 8 * * *",
      "0 1 * * *",
      "0 8-16 * * 1-5",
      "0 */6 * * *",
      "0 0 * * *",
      "0 10 * * *",
      "0 7 * * *",
      "0 20 * * *",
      "30 3 * * *",
      "17 * * * *"
    ]
  }
}
