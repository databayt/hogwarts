/**
 * Main Prisma Schema File
 * This file defines the datasource and generator configuration for the Prisma Client.
 * Multi-file Schema Structure:
 * - This file: Datasource and generator configuration
 * - prisma.config.ts: Schema path, migrations, and seed configuration
 * - prisma/models/*.prisma: 33 model files with business logic
 * All *.prisma files in the prisma directory (including subdirectories)
 * are automatically included when prisma.config.ts points to the prisma folder.
 * Note: The datasource URL in prisma.config.ts can override the URL defined here,
 * but the datasource block itself must remain in the schema.
 */

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // We build on macOS and deploy prebuilt to Vercel, so the Linux engines must
  // be generated here: `rhel-openssl-3.0.x` for x86-64 lambdas and
  // `linux-arm64-openssl-3.0.x` for arm64 ones. `vercel build` on Apple
  // Silicon tags every function `architecture: arm64`, and without the arm64
  // engine every query in those functions throws
  // PrismaClientInitializationError at runtime — the live-class crons 500'd
  // on every run from 2026-08-31 to 2026-09-03 for exactly this reason.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}
