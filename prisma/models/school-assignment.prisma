// School Assignment — school-scoped assignments (has schoolId)
// Renamed from Assignment to avoid conflict with catalog Assignment

enum AssessmentType {
  HOMEWORK
  QUIZ
  TEST
  MIDTERM
  FINAL_EXAM
  PROJECT
  LAB_REPORT
  ESSAY
  PRESENTATION
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  GRADED
}

model SchoolAssignment {
  id           String           @id @default(cuid())
  schoolId     String
  // Legacy: the class it was set for. New assignments are scoped by grade +
  // (section | whole grade) + subject instead — classes are retired.
  classId      String?
  // Scope (new assignments): a grade, optionally one section of it (null =
  // the whole grade), the subject, the term, and who set it.
  gradeId      String?
  sectionId    String?
  subjectId    String?
  termId       String?
  createdById  String? // User id
  title        String
  description  String?          @db.Text
  type         AssessmentType
  status       AssessmentStatus @default(DRAFT)
  totalPoints  Decimal          @db.Decimal(5, 2)
  weight       Decimal          @db.Decimal(5, 2)
  dueDate      DateTime
  publishDate  DateTime?
  instructions String?          @db.Text

  // Optional catalog FK bridge
  catalogLessonId     String?
  catalogAssignmentId String?

  school              School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class?                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  grade               AcademicGrade?         @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  section             Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject             Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  term                Term?                  @relation(fields: [termId], references: [id], onDelete: SetNull)
  catalogLesson       Lesson?                @relation(fields: [catalogLessonId], references: [id], onDelete: SetNull)
  catalogAssignment   Assignment?            @relation(fields: [catalogAssignmentId], references: [id], onDelete: SetNull)
  submissions         AssignmentSubmission[]
  results             Result[]
  conferenceResources ConferenceResource[]

  wizardStep String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([schoolId, classId])
  @@index([schoolId, gradeId])
  @@index([schoolId, sectionId])
  @@index([schoolId, subjectId])
  @@index([schoolId, termId])
  @@index([dueDate])
  @@index([status])
  @@index([catalogAssignmentId])
  @@map("assignments")
}

enum SubmissionStatus {
  NOT_SUBMITTED
  DRAFT
  SUBMITTED
  LATE_SUBMITTED
  GRADED
  RETURNED
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  schoolId     String
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt  DateTime?
  content      String?          @db.Text
  attachments  String[]
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?          @db.Text
  gradedAt     DateTime?
  gradedBy     String?

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment SchoolAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, assignmentId, studentId])
  @@index([schoolId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}
