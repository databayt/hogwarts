// Audit Log Model
// NOTE: schoolId is optional to allow school-dashboard-level auditing by DEVELOPER role
// For school-scoped actions, schoolId should always be provided
model AuditLog {
  id        String  @id @default(cuid())
  userId    String? // Optional — null = system actor (cron, worker, webhook)
  schoolId  String? // Optional for school-dashboard-level actions (DEVELOPER role)
  action    String
  reason    String?
  ip        String?
  userAgent String?

  // Entity tracking for audit trail
  entityType String? // "EXAM", "STUDENT", "GRADE", etc.
  entityId   String?

  // Value change tracking
  previousValue String? @db.Text
  newValue      String? @db.Text

  // Metadata for additional context
  metadata Json?

  createdAt DateTime @default(now())

  // Relationships
  school    School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  performer User?   @relation("AuditPerformer", fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, userId])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  schoolId      String?
  email         String
  ip            String?
  userAgent     String?
  success       Boolean
  failureReason String?
  // "app" | "web" — which client the sign-in came from.
  client        String?  @db.VarChar(8)
  timestamp     DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, timestamp])
  @@index([email, timestamp])
  @@index([ip, timestamp])
  @@map("login_attempts")
}

// One row per person: how they last used the platform. Written by
// `touchActivity` (src/lib/activity.ts), throttled to ~1 write/hour unless the
// client/platform/app version changed. Feeds the readiness status.
model UserPresence {
  id               String    @id @default(cuid())
  userId           String    @unique
  schoolId         String?
  lastSeenAt       DateTime
  lastClient       String?   @db.VarChar(8) // "app" | "web"
  lastPlatform     String?   @db.VarChar(12)
  lastAppVersion   Int?
  lastAppAt        DateTime? // last time the native app was used
  lastAndroidWebAt DateTime? // last time an Android phone used the web instead
  updatedAt        DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, lastSeenAt])
  @@map("user_activity")
}
