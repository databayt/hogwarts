// School and School Structure Models

model School {
  id                String   @id @default(cuid())
  name              String
  nameEn            String? // English name (used when locale is "en", avoids translation API)
  domain            String   @unique // e.g., "hogwarts" for hogwarts.schoolapp.com
  logoUrl           String?
  address           String?
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  phoneNumber       String?
  email             String?
  website           String?
  timezone          String   @default("Africa/Khartoum")
  preferredLanguage String   @default("ar") // Admin's chosen content language ("ar" or "en")
  nameFormat        String   @default("full") // "full" (single full name field) | "split" (first+last fields)

  // School classification
  schoolType         String? // private, public, international, technical, special
  schoolLevel        String? // primary, secondary, both
  timetableStructure String? @map("curriculum") // timetable structure slug, e.g. "us-standard"
  description        String? @db.Text

  // Location breakdown (address stays as street address)
  city    String?
  state   String?
  country String?

  // Subscription/billing info (high-level; detailed state in Subscription)
  planType    String  @default("basic") // basic, premium, enterprise
  // The pilot/trial clock. Nullable because most schools never trial.
  // isTenantOnTrial()/getTrialDaysRemaining() consume it; before this field
  // existed they were passed undefined and the trial column was always blank.
  trialEndsAt DateTime?
  maxStudents Int     @default(100)
  maxTeachers Int     @default(10)
  isActive    Boolean @default(true)

  // Pricing
  tuitionFee      Decimal? @db.Decimal(10, 2)
  registrationFee Decimal? @db.Decimal(10, 2)
  applicationFee  Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  paymentSchedule String   @default("annual") // monthly, quarterly, semester, annual

  // Capacity
  maxClasses         Int @default(20)
  sectionsPerGrade   Int @default(2)
  studentsPerSection Int @default(30)

  // Video storage quota (Stream LMS)
  videoStorageUsedBytes  BigInt? @default(0)
  videoStorageQuotaBytes BigInt? // null = unlimited

  // Conference (LiveKit) — per-school capacity + PDPL retention
  conferenceRetentionDays    Int                  @default(90) @map("liveClassRecordingRetentionDays")
  conferenceMaxConcurrent    Int                  @default(50) @map("liveClassMaxConcurrentPerSchool")
  conferenceMaxDuration      Int                  @default(120) @map("liveClassMaxDurationMinutes")
  conferenceRecordingDefault Boolean              @default(true) @map("liveClassRecordingDefault")
  // Opt-in: when a live class ends, auto-mark attendance from participant
  // presence (LiveKit sessions only — external links carry no presence data).
  conferenceAttendanceSync   Boolean              @default(false) @map("liveClassAttendanceSync")
  // Attendance-from-presence thresholds (minutes). Were constants in
  // attendance-sync.ts until 2026-08-30; a school sets its own.
  conferenceLateGraceMinutes   Int @default(10) @map("liveClassLateGraceMinutes")
  conferenceMinPresenceMinutes Int @default(5)  @map("liveClassMinPresenceMinutes")
  conferenceEarlyLeaveMinutes  Int @default(10) @map("liveClassEarlyLeaveMinutes")
  // Configuration options (2026-08-30 "recommended next" batch).
  // The notice students see on joining a recorded class; null = the app's default sentence.
  conferenceRecordingConsentNote  String?  @map("liveClassRecordingConsentNote")
  // Publish a finished class recording to the linked Lumos lesson automatically.
  conferenceAutoPublishRecordings Boolean  @default(true) @map("liveClassAutoPublishRecordings")
  // Guardians may join as observers.
  conferenceGuardiansObserve      Boolean  @default(true) @map("liveClassGuardiansObserve")
  // Students enter with mic + camera off (a session may override).
  conferenceStudentsJoinMuted     Boolean  @default(true) @map("liveClassStudentsJoinMuted")
  // Room tools offered in this school's rooms.
  conferenceToolChat              Boolean  @default(true) @map("liveClassToolChat")
  conferenceToolHands             Boolean  @default(true) @map("liveClassToolHands")
  conferenceToolPolls             Boolean  @default(true) @map("liveClassToolPolls")
  conferenceToolWhiteboard        Boolean  @default(true) @map("liveClassToolWhiteboard")
  conferenceToolStudentShare      Boolean  @default(false) @map("liveClassToolStudentShare")
  // How many minutes before a class the "starting soon" reminder goes out.
  conferenceReminderLeadMinutes   Int      @default(10) @map("liveClassReminderLeadMinutes")
  // "This school teaches online": every timetable slot is delivered as a live
  // class, with the session materialized per school-calendar day rather than
  // pre-created for the whole term. Overridable per section
  // (Section.conferenceOnline). See conference/online-policy.ts.
  // The school's delivery mode — physical / online / hybrid. Read FIRST by the
  // policy engine; `conferenceOnlineDefault` only matters in hybrid mode.
  conferenceDeliveryMode     SchoolDeliveryMode   @default(physical) @map("liveClassDeliveryMode")
  conferenceOnlineDefault    Boolean              @default(false) @map("liveClassOnlineDefault")
  // Preferred back-end for those sessions. Degrades to `external` at read time
  // whenever isLiveKitConfigured() is false, so a school can select `livekit`
  // before the SFU is provisioned and be promoted automatically when it lands.
  conferenceProviderDefault  ConferenceProvider   @default(external) @map("liveClassProviderDefault")
  // Temporary "go online" window — the emergency switch (war, weather, an
  // outbreak, a closed road). Day-granular in the SCHOOL's calendar and
  // INCLUSIVE at both ends; `from` is required for a window to exist, `until`
  // is optional and null means "until further notice". It temporarily raises
  // the school-wide default — it does NOT override an explicit per-section
  // decision, because going online never closes the building: online delivery
  // is ADDITIVE to the physical class, so there is nothing to override.
  conferenceOnlineFrom       DateTime?            @map("liveClassOnlineFrom")
  conferenceOnlineUntil      DateTime?            @map("liveClassOnlineUntil")
  // Why the school went online — shown to staff on the settings page and in
  // the reason tally. Free text, single-language (see the translation rule).
  conferenceOnlineNote       String?              @map("liveClassOnlineNote")
  // HOW online classes are delivered: bound to the timetable, a loose open
  // room per section, or both. See ConferenceOnlineMode.
  conferenceOnlineMode       ConferenceOnlineMode @default(timetable) @map("liveClassOnlineMode")
  // Standing meeting URL used when a (section, subject) has no ConferenceLink
  // of its own — the difference between "the school went online overnight and
  // every class is joinable" and "nothing materialized". Shared across every
  // section that falls back to it; per-section links stay the private option.
  conferenceFallbackUrl      String?              @map("liveClassFallbackUrl")

  // Join code for users to self-enroll (6-char alphanumeric, regeneratable)
  joinCode String? @unique

  // Owner tracking - immutable, set during school creation
  // Ensures one user can only create one school (prevents duplicates from race conditions)
  createdByUserId String? @unique

  // Onboarding lifecycle
  onboardingStep        String?
  onboardingCompletedAt DateTime?
  isPublished           Boolean   @default(false)

  // School relationships
  users                     User[]
  schoolYears               SchoolYear[]
  periods                   Period[]
  terms                     Term[]
  departments               Department[]
  yearLevels                YearLevel[]
  students                  Student[]
  teachers                  Teacher[]
  teacherQualifications     TeacherQualification[]
  teacherExperiences        TeacherExperience[]
  teacherSubjectExpertise   TeacherSubjectExpertise[]
  workloadConfigs           WorkloadConfig[]
  guardians                 Guardian[]
