// Score ranges (letter-grade bands). The Class, StudentClass and ClassTeacher
// models were retired on 2026-10-04 — teaching is SubjectTeacher.

model ScoreRange {
  id       String  @id @default(cuid())
  schoolId String
  minScore Decimal @db.Decimal(5, 2)
  maxScore Decimal @db.Decimal(5, 2)
  grade    String // A+, A, B+, B, etc.

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, grade]) // Unique grade per school
  @@map("score_ranges")
}
