# LiveKit server — the generator's production config (github.com/livekit/deploy,
# generate/production.go), plus our webhook. Rendered by render-cloud-init.py;
# __API_KEY__ / __API_SECRET__ come from Keychain, never from git.
port: 7880
bind_addresses:
  - ""
logging:
  json: false
  level: info
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
redis:
  address: localhost:6379
turn:
  enabled: true
  domain: __TURN_DOMAIN__
  tls_port: 5349
  udp_port: 3478
  external_tls: true
keys:
  __API_KEY__: __API_SECRET__
webhook:
  api_key: __API_KEY__
  urls:
    - __WEBHOOK_URL__
