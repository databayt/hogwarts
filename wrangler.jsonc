{
  // hogwarts on Cloudflare — a thin Worker in front of ONE always-on container
  // running the Next standalone server (the app is far too large for a Worker:
  // 31.6 MB gzipped vs a 10 MiB ceiling, measured 2026-09-07). Build + deploy:
  // scripts/deploy-cloudflare.sh. Secrets: scripts/cf-secrets.sh.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hogwarts",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "HogwartsContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      // ½ vCPU, 4 GiB. `basic` (1 GiB) is too small for a next start of this size.
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HOGWARTS", "class_name": "HogwartsContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HogwartsContainer"] }],
  // Routes capture a hostname only once its DNS record is PROXIED (orange cloud):
  // grey-clouded records still resolve straight to Vercel. Cutover = toggle the
  // cloud per record (demo first, then apex/www, then the `*` record); rollback =
  // toggle it back. scripts/cf-cutover.sh does it through the API.
  "routes": [
    { "pattern": "balqalam.com/*", "zone_name": "balqalam.com" },
    { "pattern": "*.balqalam.com/*", "zone_name": "balqalam.com" }
  ],
  // No cron triggers on purpose: schedules must not run from two hosts at once.
}
